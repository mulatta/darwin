{
  lib,
  fetchFromGitHub,
  makeWrapper,
  python3,
  rustPlatform,
  stdenvNoCC,
  versionCheckHook,
  writableTmpDirAsHomeHook,
  extraPythonPackages ? (_: [ ]),
}:

stdenvNoCC.mkDerivation (finalAttrs: {
  pname = "prime-agent";
  version = "0.10.2";

  src = fetchFromGitHub {
    owner = "PrimeIntellect-ai";
    repo = "prime-agent";
    tag = "v${finalAttrs.version}";
    hash = "sha256-W9lEIKpiX7+KeIpaKWt1uuYrF/ZhBHtgUBn8HwdKIHQ=";
  };

  patches = [
    # Upstream factory SKILL.md frontmatter is invalid YAML, so discovery drops the skill;
    ./patches/0001-skills-quote-the-factory-skill-description.patch
  ];

  cargoHash = "sha256-qRr2PDs8QD/Z+DXYFVkcX700HHTCF3RpAS0v/63xDu4=";
  cargoBuildType = "release";
  cargoBuildFlags = [
    "-p"
    "pa-cli"
    "--bin"
    "prime-agent"
  ];

  nativeBuildInputs = [
    makeWrapper
    python3
  ];

  dontConfigure = true;
  # The Rust derivation already fixes up the executable.
  dontStrip = true;

  buildPhase = ''
    runHook preBuild

    python3 scripts/release/bundle_catalog.py generate \
      --catalog-dir ${finalAttrs.passthru.catalogSrc} \
      --out target/catalog-assets

    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    packageDir=$out/share/prime-agent
    mkdir -p $out/bin "$packageDir"
    install -Dm755 ${finalAttrs.passthru.unwrapped}/bin/prime-agent \
      "$packageDir/prime-agent"
    cp -r prime-agent-runtime skills "$packageDir/"
    # websearch needs a Serper key, prime-intellect the Prime Intellect CLI.
    rm -r "$packageDir"/skills/{websearch,prime-intellect}
    ${lib.concatMapStringsSep "\n" (
      p: ''cp -r ${p.src} "$packageDir/skills/${p.passthru.skill}"''
    ) finalAttrs.passthru.darwinSkills}
    install -Dm644 README.md LICENSE target/catalog-assets/*.json \
      -t "$packageDir"

    # Reproduce the package metadata generated by upstream's Rust release packer.
    cat > "$packageDir/package.json" <<'JSON'
    {
      "name": "prime-agent",
      "version": "${finalAttrs.version}",
      "description": "Prime Agent: the RLM coding agent (Rust build)",
      "bin": { "prime-agent": "prime-agent" },
      "piConfig": { "name": "prime-agent", "configDir": ".prime/agent" }
    }
    JSON

    # Upstream telemetry is on by default; DO_NOT_TRACK outranks PRIME_AGENT_TELEMETRY=1.
    makeWrapper "$packageDir/prime-agent" $out/bin/prime-agent \
      --set PI_PACKAGE_DIR "$packageDir" \
      --set DO_NOT_TRACK 1 \
      --prefix PATH : ${finalAttrs.passthru.pythonRuntime}/bin \
      --set PRIME_AGENT_KERNEL_PYTHON ${finalAttrs.passthru.pythonRuntime}/bin/python3 \
      --set DARWIN_MARIMO_PYTHON ${finalAttrs.passthru.marimoServer}/bin/python3

    runHook postInstall
  '';

  doInstallCheck = true;
  nativeInstallCheckInputs = [
    versionCheckHook
    writableTmpDirAsHomeHook
  ];
  # prime-agent reads its config dir under HOME even for --version.
  versionCheckKeepEnvironment = [ "HOME" ];

  postInstallCheck = ''
    expectedSkills="agent-message agent-observe artifact attach-image compact edit factory goal mcp pair record refine rlm-heartbeat skill-creator"
    installedSkills="$(${finalAttrs.passthru.pythonRuntime}/bin/python3 - "$out/share/prime-agent/skills" <<'PY'
    from pathlib import Path
    import sys

    root = Path(sys.argv[1])
    print(" ".join(sorted(path.name for path in root.iterdir() if (path / "SKILL.md").is_file())))
    PY
    )"
    test "$installedSkills" = "$expectedSkills"

    # Discovery skips a skill whose frontmatter does not parse or lacks a description.
    ${finalAttrs.passthru.pythonRuntime}/bin/python3 - "$out/share/prime-agent/skills" <<'PY'
    import sys
    from pathlib import Path

    import yaml

    for skill in sorted(p for p in Path(sys.argv[1]).iterdir() if (p / "SKILL.md").is_file()):
        front = yaml.safe_load(skill.joinpath("SKILL.md").read_text().split("---")[1])
        assert front["name"] == skill.name, skill
        assert front.get("description"), skill
    PY

    python3 - "$out/share/prime-agent" <<'PY'
    import json
    import sys
    from pathlib import Path

    package_dir = Path(sys.argv[1])
    models = json.loads((package_dir / "models.bundled.json").read_text())["models"]
    services = json.loads((package_dir / "mcp-services.bundled.json").read_text())["entries"]
    assert models and services
    assert all(not model["id"].startswith("fixture-") for model in models)
    assert all(not service["server"].startswith("fixture-") for service in services)
    PY

    ${finalAttrs.passthru.pythonRuntime}/bin/python3 <<'PY'
    import inspect
    import importlib.metadata

    import agent_message, agent_observe, attach_image, compact, edit, goal
    import refine, rlm, rlm_heartbeat
    import artifact, pair, record

    assert callable(rlm.spawn)
    assert inspect.signature(rlm.spawn).parameters["name"].default is inspect.Parameter.empty
    assert not hasattr(rlm, "run")
    assert callable(rlm.host_request)
    assert callable(rlm.create_session)
    assert callable(rlm.collect)
    assert callable(rlm.progress_note)
    assert callable(rlm.rename)
    assert callable(rlm.rlm.factory.run)
    assert callable(rlm.rlm.factory.help)

    from importlib.resources import files
    for name in ["builder", "pr-manager", "review-sweep"]:
        assert files("rlm").joinpath("machines", name, "MACHINE.md").is_file(), name
    assert callable(agent_observe.list_agents)
    assert callable(agent_observe.get_agent)
    assert callable(agent_observe.recent_messages)
    assert callable(refine.run)
    assert callable(refine.status)

    import rlm.mcp
    for name in ["list_plugins", "search_plugins", "list_connections", "search_tools", "describe_tool", "list_tools", "call_tool"]:
        assert callable(getattr(rlm.mcp, name, None)), name

    distributions = importlib.metadata.packages_distributions()["rlm"]
    assert distributions == ["prime-agent-runtime"], distributions
    PY

    # A kernel venv without marimo gets this site-packages on PYTHONPATH, so research packages must not leak.
    ${finalAttrs.passthru.marimoServer}/bin/python3 <<'PY'
    import importlib.util

    import marimo, msgspec, zmq

    leaked = [m for m in ["artifact", "numpy", "pandas", "pyarrow", "rlm", "scipy"] if importlib.util.find_spec(m)]
    assert not leaked, leaked
    PY
  '';

  passthru = {
    # Keep Python and resource assembly out of the Rust build inputs.
    unwrapped = rustPlatform.buildRustPackage {
      pname = "prime-agent-unwrapped";
      inherit (finalAttrs)
        version
        src
        cargoHash
        cargoBuildFlags
        cargoBuildType
        ;

      # Upstream snapshot tests depend on terminal color and width detection.
      doCheck = false;
      doInstallCheck = true;
      nativeInstallCheckInputs = [
        versionCheckHook
        writableTmpDirAsHomeHook
      ];
      versionCheckKeepEnvironment = [ "HOME" ];
      meta = finalAttrs.meta;
    };

    # Bundle a real, immutable catalog; upstream's --fixture is test data.
    catalogSrc = fetchFromGitHub {
      owner = "PrimeIntellect-ai";
      repo = "prime-agent-catalog";
      rev = "d4a099cf2aae7ea8c231298e93fd535756ef43c9";
      hash = "sha256-dRDI9/Og95wM9MCYPcgoCP20P2kSKUnTwfMgxoPT5fg=";
    };

    primeAgentRuntime = python3.pkgs.buildPythonPackage {
      pname = "prime-agent-runtime";
      version = "0.1.0";
      src = "${finalAttrs.src}/prime-agent-runtime";
      pyproject = true;
      build-system = [ python3.pkgs.hatchling ];
      dependencies = with python3.pkgs; [
        mcp
        tyro
      ];
      pythonImportsCheck = [ "rlm" ];
    };

    # Shared by the bundled upstream skills and darwin's own skills.
    buildSkill =
      {
        directory,
        version,
        pname ? directory,
        dependencies ? [ ],
        src ? "${finalAttrs.src}/skills/${directory}",
        nativeCheckInputs ? [ ],
        preCheck ? "",
      }:
      python3.pkgs.buildPythonPackage {
        inherit
          pname
          version
          dependencies
          src
          nativeCheckInputs
          preCheck
          ;
        pyproject = true;
        build-system = [ python3.pkgs.hatchling ];
        pythonImportsCheck = [ (builtins.replaceStrings [ "-" ] [ "_" ] directory) ];
        passthru.skill = directory;
      };

    pythonSkills =
      let
        runtime = finalAttrs.passthru.primeAgentRuntime;
      in
      # update.py reads each bundled skill version from its pyproject.toml.
      [
        (finalAttrs.passthru.buildSkill {
          directory = "agent-message";
          version = "0.1.0";
          dependencies = [ runtime ];
        })
        (finalAttrs.passthru.buildSkill {
          directory = "agent-observe";
          version = "0.1.0";
          dependencies = [ runtime ];
        })
        (finalAttrs.passthru.buildSkill {
          directory = "attach-image";
          version = "0.1.0";
          pname = "prime-agent-skill-attach-image";
          dependencies = with python3.pkgs; [
            pillow
            runtime
          ];
        })
        (finalAttrs.passthru.buildSkill {
          directory = "compact";
          version = "0.1.0";
          dependencies = [ runtime ];
        })
        (finalAttrs.passthru.buildSkill {
          directory = "edit";
          version = "0.1.0";
          dependencies = [ runtime ];
        })
        (finalAttrs.passthru.buildSkill {
          directory = "goal";
          version = "0.1.0";
          dependencies = [ runtime ];
        })
        (finalAttrs.passthru.buildSkill {
          directory = "refine";
          version = "0.1.0";
          dependencies = [ runtime ];
        })
        (finalAttrs.passthru.buildSkill {
          directory = "rlm-heartbeat";
          version = "0.1.0";
          dependencies = [ runtime ];
        })
      ];

    # darwin's own skills from ../skills, bundled next to the upstream ones.
    darwinSkills =
      let
        inherit (finalAttrs.passthru) buildSkill;
        skill =
          directory: dependencies:
          buildSkill {
            inherit directory dependencies;
            version = "0.1.0";
            pname = "skill-${directory}";
            src = ../skills/${directory};
            nativeCheckInputs = [
              python3.pkgs.pytestCheckHook
              writableTmpDirAsHomeHook
            ];
            # pair tests start real marimo servers on loopback.
            preCheck = "export DARWIN_MARIMO_PYTHON=${finalAttrs.passthru.marimoServer}/bin/python3";
          };
        artifact = skill "artifact" (
          with python3.pkgs;
          [
            pandas
            pyarrow
          ]
        );
        pair = skill "pair" [
          python3.pkgs.httpx
          artifact
        ];
        record = skill "record" [
          artifact
          pair
        ];
      in
      [
        artifact
        pair
        record
      ];

    # Serves marimo notebooks; kernels run in the project's own environment.
    marimoServer = python3.withPackages (ps: [ ps.marimo ]);

    pythonRuntime = python3.withPackages (
      ps:
      (with ps; [
        beautifulsoup4
        dill
        httpx
        ipykernel
        ipython
        lxml
        mcp
        nest-asyncio
        numpy
        pandas
        pillow
        pydantic
        python-dotenv
        pyyaml
        requests
        scipy
        tomli
        tyro
      ])
      ++ [ finalAttrs.passthru.primeAgentRuntime ]
      ++ finalAttrs.passthru.pythonSkills
      ++ finalAttrs.passthru.darwinSkills
      ++ extraPythonPackages ps
    );
  };

  meta = {
    description = "A self-improving RLM agent for coding workflows and long-running autonomous tasks.";
    homepage = "https://github.com/PrimeIntellect-ai/prime-agent";
    changelog = "https://github.com/PrimeIntellect-ai/prime-agent/releases/tag/v${finalAttrs.version}";
    license = lib.licenses.mit;
    sourceProvenance = with lib.sourceTypes; [ fromSource ];
    maintainers = lib.maintainers.mulatta;
    mainProgram = "prime-agent";
    platforms = lib.platforms.unix;
  };
})
